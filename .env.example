# ========================================================
# Extoken 私有化部署 - 环境变量模板
# 使用方法：复制本文件为 .env 后按实际情况修改
# ========================================================

# ---------- Node 运行环境 ----------
NODE_ENV=production
TZ=Asia/Shanghai

# ---------- 应用服务 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# 应用对外访问的 URL（给外部 Agent 打包/取件的接入指令里用，
#  如：https://extoken.example.com  或者  http://<ECS公网IP>:3000）
APP_PUBLIC_URL=https://extoken.your-domain.com

# 应用名称（显示在前端顶部 + 公开项目更新接口里）
APP_NAME=Extoken 交换站

# ---------- 数据库（PostgreSQL）----------
# 推荐 ECS 上用 apt/dnf 直接装 postgresql-16；或 docker run -d postgres:16
DATABASE_URL=postgresql://extoken:your_strong_db_password@127.0.0.1:5432/extoken?schema=public&sslmode=disable

# 可选：如果你想拆成独立字段
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=extoken
# DB_PASSWORD=your_strong_db_password
# DB_NAME=extoken

# ---------- JWT 鉴权 ----------
# 生成方式：openssl rand -base64 64   （或任何 64 字节以上随机字符串）
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_64_bytes_please_generate_new
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_different_from_access

# Token 有效期
JWT_ACCESS_TTL=900            # 15 分钟（秒）
JWT_REFRESH_TTL=604800        # 7 天（秒）

# Cookie 用的密钥（如果你启用 httpOnly refresh token cookie）
COOKIE_SECRET=replace_me_with_third_random_string

# ---------- 安全 / CORS ----------
# 允许跨域的前端地址。多个用英文逗号分隔。
# 开发态默认 http://localhost:5173；
# 生产态如果 Nginx 同域反代可以留 * 或写具体域名
CORS_ORIGIN=https://extoken.your-domain.com,http://localhost:5173,http://127.0.0.1:5173

# 登录 / 注册接口限流（次/分钟/IP）
AUTH_RATE_LIMIT=20
# 开放网关打包/取件接口限流（次/分钟/IP + x-extoken-key）
OPENAPI_RATE_LIMIT=60

# ---------- 管理员初始化 ----------
# 首次启动 db:init 时创建的初始管理员账号（密码要求 8 位以上含大小写+数字）
# 登录后请到"管理台"修改密码，并立即删除这一行（或在 .env 里注释掉）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=ChangeMe123!
INIT_ADMIN_NICKNAME=超级管理员

# ---------- 开放网关凭证（给外部 Agent 用）----------
# 原妙搭 aPaaS 的网关 Bearer Token 概念保留，私有化部署了你可以自定义一个固定字符串，
# 外部 Agent 调 /openapi/extoken/* 时必须带  Authorization: Bearer <OPENAPI_GATEWAY_TOKEN>
# 生成方式：openssl rand -base64 48
OPENAPI_GATEWAY_TOKEN=replace_me_with_a_long_random_gateway_token

# ---------- 日志 ----------
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_LEVEL=info  # error | warn | info | debug
